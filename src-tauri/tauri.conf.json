{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Worktree",
  "version": "0.31.0",
  "identifier": "io.github.devpumpkin0113.worktree",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Worktree",
        "width": 1280,
        "height": 850,
        "minWidth": 760,
        "minHeight": 560,
        "decorations": false,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "DevPumpkin0113"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlFREM4QjdDRjNDQkVBMDYKUldRRzZzdnpmSXZjbnZYaHQyVkRieVdodzNKMGxiVGpxdFZoWHhnaDN5R2gyV0tpMzcrRnRRODEK",
      "endpoints": [
        "https://github.com/DevPumpkin0113/worktree/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  }
}
