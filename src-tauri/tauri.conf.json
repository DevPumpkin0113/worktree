{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Worktree",
  "version": "0.3.5",
  "identifier": "local.toothless.worktree",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Worktree",
        "width": 1280,
        "height": 850,
        "minWidth": 760,
        "minHeight": 560,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "wbs"
        ],
        "name": "WBS Document",
        "description": "Markdown Work Breakdown Structure",
        "role": "Viewer"
      }
    ]
  }
}
